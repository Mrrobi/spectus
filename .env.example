OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL_INTENT=gpt-4o-mini
OPENAI_MODEL_PLAN=gpt-4.1
OPENAI_MODEL_REPAIR=gpt-4.1

DB_URL=sqlite+aiosqlite:///./spectus.db
ARTIFACTS_DIR=./artifacts
METRICS_PATH=./metrics.json

USER_AGENT=Mozilla/5.0 (compatible; spectus/0.1; +https://example.invalid/bot)
BROWSER_POOL_SIZE=3
BROWSER_HEADLESS=true
BROWSER_RECYCLE_USES=50
BROWSER_RECYCLE_SECONDS=1800

RATE_LIMIT_RPS=1.0
RATE_LIMIT_BURST=1.0
ALLOW_PRIVATE_TARGETS=false

ROBOTS_CACHE_TTL_SEC=3600
HTTP_TIMEOUT_SEC=10
HTTP_CONNECT_TIMEOUT_SEC=2

JOB_DEADLINE_SEC=60
LLM_INTENT_TIMEOUT_SEC=12
LLM_PLANNER_TIMEOUT_SEC=20
LLM_REPAIR_TIMEOUT_SEC=20

MAX_RECORDS_HARD_CAP=1000
MAX_HTML_BYTES=5242880

LOG_LEVEL=INFO
